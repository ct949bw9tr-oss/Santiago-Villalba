{
  "expo": {
    "name": "TaskSwift",
    "slug": "taskswift",
    "scheme": "taskswift",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5FFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.taskswift.app"
    },
    "android": {
      "package": "co.taskswift.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5FFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/Santiago-Villalba"
    }
  }
}
