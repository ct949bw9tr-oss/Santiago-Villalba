# Copy to .env and fill in real values. Never commit the real .env file.
# NEVER put secret keys (service role, payment secret keys) in client/mobile code —
# they belong in server-side functions / the admin app's server runtime only.

# ---------- Database ----------
# Local Postgres for development, or a Supabase project's connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskswift_dev

# ---------- Supabase ----------
# Public — safe for the mobile app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret — server-side only (admin app, edge functions). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Maps ----------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------- Payments (Colombia launch: Wompi; others are stubs for expansion) ----------
# Public keys are safe in the mobile bundle; secret keys are server-side only.
EXPO_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# When no provider credentials are configured, the app falls back to the "mock"
# payment provider (see packages/config/src/countries.ts) for local development.

# ---------- Notifications ----------
EXPO_PUBLIC_PROJECT_ID=
EXPO_ACCESS_TOKEN=

# ---------- Admin app (apps/admin) ----------
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
