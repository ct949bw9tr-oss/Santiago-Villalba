{
  "name": "taskswift",
  "private": true,
  "version": "0.1.0",
  "description": "TaskSwift - local services marketplace monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "mobile": "pnpm --filter @taskswift/mobile start",
    "admin": "pnpm --filter @taskswift/admin dev",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:seed": "bash scripts/db-seed.sh",
    "generate:seed": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "@taskswift/config": "workspace:*",
    "@taskswift/types": "workspace:*",
    "@taskswift/business-logic": "workspace:*",
    "@taskswift/seed-data": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.1"
  }
}
